<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme (parent) -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#6D4C41</item>
        <item name="colorPrimaryDark">#4E342E</item>
        <item name="colorAccent">#8D6E63</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:textColorPrimary">@color/text_light_primary</item>
        <item name="android:textColorSecondary">@color/text_light_secondary</item>
    </style>

    <style name="SkeuomorphicButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/skeuomorphic_button</item>
        <item name="android:textColor">@color/btn_text_light</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <style name="SkeuomorphicCard">
        <item name="android:background">@drawable/skeuomorphic_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_margin">12dp</item>
    </style>
</resources>
