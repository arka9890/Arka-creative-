<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme overrides -->
    <style name="AppTheme" parent="Theme.AppCompat">
        <item name="colorPrimary">#8D6E63</style>
        <item name="colorPrimaryDark">#5D4037</style>
        <item name="colorAccent">#A1887F</style>
        <item name="android:windowBackground">@color/bg_dark</style>
        <item name="android:textColorPrimary">@color/text_dark_primary</style>
        <item name="android:textColorSecondary">@color/text_dark_secondary</style>
    </style>

    <style name="SkeuomorphicButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/skeuomorphic_button_dark</style>
        <item name="android:textColor">@color/btn_text_dark</style>
        <item name="android:textStyle">bold</style>
        <item name="android:textSize">14sp</style>
        <item name="android:padding">12dp</style>
        <item name="android:layout_margin">8dp</style>
    </style>
</resources>
